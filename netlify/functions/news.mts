import type { Config } from '@netlify/functions';
import { articles, card, date, escape, html, isFresh, origin, page, popupCandidate, status, type Article } from './lib/editorial.mts';

const json = (data: unknown, ttl: number) => Response.json(data, { headers: { 'Cache-Control': `public, max-age=${ttl}`, 'X-Robots-Tag': 'noindex' } });
const readMinutes = (a: Article) => Math.max(1, Math.ceil(a.sections.reduce((n, s) => n + s.text.split(/\s+/).length, 0) / 200));
const paragraphs = (text: string) => text.split(/\n{2,}/).map(p => `<p>${escape(p)}</p>`).join('');

function articlePage(a: Article, all: Article[]) {
  const canonical = origin() + '/news/' + a.slug;
  const cover = a.image ? `<figure class="article-cover-wrap"><img data-optional class="article-cover" src="${escape(a.image)}" alt="${escape(a.image_alt)}" width="1440" height="810" fetchpriority="high" referrerpolicy="no-referrer"></figure>` : '';
  const named = a.sections.filter(s => s.heading);
  const body = `<section class="hero article-heading"><div class="container"><nav class="article-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/news">News</a> / <span>${escape(a.category)}</span></nav><span class="eyebrow"><i class="fa-solid fa-newspaper" aria-hidden="true"></i> ${escape(a.category)}${isFresh(a) ? ' <b class="chip-new">New</b>' : ''}${a.priority === 'important' || a.priority === 'critical' ? ` · ${escape(a.priority)}` : ''}</span><h1>${escape(a.title)}</h1><p class="lead">${escape(a.summary)}</p><p class="news-meta">By <a href="/about.html">${escape(a.author)}</a> · <time datetime="${escape(a.published_at)}">${date(a.published_at)}</time> · ${readMinutes(a)} min read</p>${a.updated_at !== a.published_at ? `<p class="news-meta">Updated <time datetime="${escape(a.updated_at)}">${date(a.updated_at)}</time></p>` : ''}${cover}</div></section><section class="section"><div class="container news-article-layout"><aside>${named.length > 1 ? `<nav class="article-toc" aria-label="In this story"><span class="kicker"><i class="fa-solid fa-list-ul" aria-hidden="true"></i> In this story</span>${a.sections.map((s, i) => s.heading ? `<a href="#section-${i + 1}">${escape(s.heading)}</a>` : '').join('')}</nav>` : ''}</aside><article class="article-prose">${a.expired ? `<p class="news-notice" role="note">This announcement expired on ${date(a.expires_at!)} and is kept for reference.</p>` : ''}${a.sections.map((s, i) => `<section id="section-${i + 1}">${s.heading ? `<h2>${escape(s.heading)}</h2>` : ''}${paragraphs(s.text)}</section>`).join('')}${a.actions.length ? `<p class="article-actions">${a.actions.map((x, i) => `<a class="btn${i === 0 ? ' primary' : ''}" href="${escape(x.url)}">${escape(x.label)}</a>`).join(' ')}</p>` : ''}<div class="author-note"><h2>About the editorial team</h2><p>PublishRank Editorial publishes product news and practical guides for WordPress publishers. <a href="/about.html">Learn about PublishRank</a> or <a href="/support.html">report a correction</a>.</p></div></article></div></section>${all.filter(x => x.slug !== a.slug).length ? `<section class="section"><div class="container"><span class="kicker">Keep reading</span><h2>More from PublishRank</h2><div class="news-grid">${all.filter(x => x.slug !== a.slug).slice(0, 3).map(x => card(x)).join('')}</div></div></section>` : ''}`;
  return page({
    title: a.title, description: a.summary.slice(0, 300), path: '/news/' + a.slug, body, image: a.image || undefined, imageAlt: a.image ? a.image_alt : undefined, article: a,
    schema: [{ '@type': a.type, '@id': canonical + '#article', mainEntityOfPage: canonical, url: canonical, headline: a.title.slice(0, 110), description: a.summary, datePublished: a.published_at, dateModified: a.updated_at, ...(a.image ? { image: [a.image] } : {}), inLanguage: 'en', isAccessibleForFree: true, author: { '@type': 'Organization', name: a.author, url: origin() + '/about.html' }, publisher: { '@id': origin() + '/#organization' }, articleSection: a.category, wordCount: a.sections.reduce((n, s) => n + s.text.split(/\s+/).length, 0) },
      { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: origin() + '/' }, { '@type': 'ListItem', position: 2, name: 'News', item: origin() + '/news' }, { '@type': 'ListItem', position: 3, name: a.title, item: canonical }] }],
  });
}

export default async (request: Request) => {
  if (!['GET', 'HEAD'].includes(request.method)) return new Response(null, { status: 405, headers: { Allow: 'GET, HEAD' } });
  try {
    const url = new URL(request.url);
    if (url.pathname === '/api/news/status') return json(status(await articles(Date.now(), { checkImages: false })), 60);
    const all = await articles();
    if (url.pathname === '/api/news/popup') return json({ item: popupCandidate(all) }, 120);
    if (url.pathname === '/api/news') return json({ articles: all, ...status(all) }, 300);
    const slug = decodeURIComponent(url.pathname.replace(/^\/news\/?/, '')).replace(/\/$/, '');
    if (slug) {
      const found = (await articles(Date.now(), { includeExpired: true })).find(item => item.slug === slug);
      if (!found) return html(await page({ title: 'Story not found', description: 'Browse the latest PublishRank news.', path: '/news', noindex: true, body: '<section class="hero"><div class="container"><p class="eyebrow">404 · Story not found</p><h1>This story is not here.</h1><p>It may have been unpublished or the link is mistyped.</p><a class="btn primary" href="/news"><i class="fa-solid fa-newspaper" aria-hidden="true"></i> Back to News</a></div></section>' }), 404);
      return html(await articlePage(found, all));
    }
    const query = (url.searchParams.get('q') || '').trim().slice(0, 160);
    const category = url.searchParams.get('category') || '';
    const filtered = all.filter(a => (!category || a.category === category) && (!query || `${a.title} ${a.summary} ${a.category}`.toLowerCase().includes(query.toLowerCase())));
    const categories = [...new Set(all.map(a => a.category))];
    const st = status(all);
    const body = `<section class="hero news-heading"><div class="container"><div class="eyebrow"><span class="dot"></span> PublishRank News</div><h1>Product news.<br><span>Practical guides.</span></h1><p class="lead">Announcements and guides for people who publish with WordPress. Updated straight from the PublishRank feed.</p><div class="news-heading-foot"><span>${all.length} ${all.length === 1 ? 'story' : 'stories'} · <a href="/news-sitemap.xml"><i class="fa-solid fa-sitemap" aria-hidden="true"></i> News sitemap</a> · <a href="/feed.xml"><i class="fa-solid fa-rss" aria-hidden="true"></i> Feed</a></span><a class="text-link" href="/faq"><i class="fa-solid fa-circle-question" aria-hidden="true"></i> Read the FAQ</a></div></div></section><section class="section"><div class="container"><div id="news-live" class="news-live" data-stamp="${escape(st.stamp)}" hidden><span>New stories are available.</span> <button class="btn" type="button"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Refresh</button></div><form class="news-search" action="/news" method="get" role="search"><div><label for="news-query">Search the news</label><input id="news-query" type="search" name="q" value="${escape(query)}" placeholder="Try schema, images or sitemaps"></div><div><label for="news-category">Topic</label><select id="news-category" name="category"><option value="">All topics</option>${categories.map(c => `<option${category === c ? ' selected' : ''}>${escape(c)}</option>`).join('')}</select></div><button class="btn primary" type="submit"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Find stories</button>${query || category ? '<a class="text-link" href="/news">Clear filters</a>' : ''}</form><p class="news-meta">${filtered.length} ${filtered.length === 1 ? 'story' : 'stories'}${query ? ` matching “${escape(query)}”` : ''}</p>${filtered[0] ? card(filtered[0], true) : '<div class="news-empty"><h2>No stories match this search.</h2><p>Try another topic or <a href="/news">browse all stories</a>.</p></div>'}<div class="news-grid">${filtered.slice(1).map(a => card(a)).join('')}</div></div></section>`;
    return html(await page({ title: 'News', description: 'PublishRank product news, announcements and practical WordPress publishing guides: news sitemaps, article schema, image SEO and editorial workflows.', path: '/news', body, noindex: Boolean(query || category), extraHead: '<link rel="alternate" type="application/json" href="/api/news" title="PublishRank news feed">', schema: [{ '@type': 'CollectionPage', '@id': origin() + '/news#page', url: origin() + '/news', name: 'PublishRank News', isPartOf: { '@id': origin() + '/#website' }, mainEntity: { '@type': 'ItemList', itemListElement: all.map((a, i) => ({ '@type': 'ListItem', position: i + 1, name: a.title, url: origin() + '/news/' + a.slug })) } }] }));
  } catch {
    return new Response('News is temporarily unavailable. Please try again shortly.', { status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Retry-After': '60', 'Cache-Control': 'no-store' } });
  }
};
export const config: Config = { path: ['/news', '/news/:slug', '/api/news', '/api/news/status', '/api/news/popup'] };
